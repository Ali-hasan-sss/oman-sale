NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
HOST=0.0.0.0
# Set to 1 when the API is behind one local Nginx reverse proxy.
# This makes req.ip use X-Forwarded-For so rate limits and views use the real client IP.
TRUST_PROXY=1
# --- Production (VPS) ---
# WEB_URL=https://omansale.om
# API_URL=https://api.omansale.om
# CORS_ORIGINS=https://omansale.om,https://www.omansale.om,https://api.omansale.om
# See .env.production.example and DEPLOYMENT.md
# Allow LAN/private IPs in development (default true). Set false to disable.
# CORS_ALLOW_LAN_IN_DEV=true

# --- Frontend: put in apps/web/.env (PC uses localhost; phone uses same IP as :3000 automatically) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# For same-origin Nginx deployment, use:
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_API_PORT=4000
# NEXT_PUBLIC_CONTACT_EMAIL=info@omansale.om
# NEXT_PUBLIC_CONTACT_PHONE=+968 2456 7890
# NEXT_PUBLIC_SITE_URL=https://omansale.om
# NEXT_PUBLIC_PLATFORM_TAX_NUMBER=OM-VAT-000000000
# NEXT_PUBLIC_PLATFORM_COMMERCIAL_REGISTRATION=CR-0000000

DATABASE_URL=postgresql://oman_sale:oman_sale@127.0.0.1:55432/oman_sale?schema=public
SHADOW_DATABASE_URL=postgresql://oman_sale:oman_sale@127.0.0.1:55432/oman_sale_shadow?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PASSWORD_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Media storage: local (dev) or s3 (production)
# Media storage: use `local` for development; switch to `s3` when the bucket is configured and reachable.
MEDIA_PROVIDER=local
# Do NOT set to https://omansale.om/uploads — use S3 or /api/v1/media/files via API_URL.
# MEDIA_PUBLIC_BASE_URL is only needed for public S3 buckets or a CDN URL.
# MEDIA_PUBLIC_BASE_URL=https://your-bucket.s3.me-south-1.amazonaws.com
# NEXT_PUBLIC_MEDIA_BASE_URL=https://your-bucket.s3.me-south-1.amazonaws.com

# Email auth codes. Keep true locally to avoid sending emails and use 000000.
EMAIL_SKIP_SEND=true
EMAIL_SKIP_CODE=000000
# When true, phone verification accepts 000000 without sending WhatsApp.
PHONE_SKIP_VERIFY=false

# Meta WhatsApp Cloud API (phone OTP). Setup guide: docs/whatsapp-meta-setup.html
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=oman_sale_otp
WHATSAPP_OTP_TEMPLATE_LANGUAGE=ar
# Optional English locale code if you created an en template variant
# WHATSAPP_OTP_TEMPLATE_LANGUAGE_EN=en
# Set false if your approved template has body only (no URL/copy button)
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=true
# Optional template for general notifications (not OTP)
# WHATSAPP_NOTIFICATION_TEMPLATE_NAME=oman_sale_alert
# WHATSAPP_NOTIFICATION_TEMPLATE_LANGUAGE=ar
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Oman Sale <no-reply@omansale.local>"

# Thawani payment gateway (store subscriptions)
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_SANDBOX=true
# Set true to skip Thawani and auto-activate paid subscriptions
# In development, checkout is also skipped automatically when keys are missing
THAWANI_SKIP_CHECKOUT=false

# OpenAI assistant chatbot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ASSISTANT_RATE_LIMIT_MAX=30
ASSISTANT_DAILY_LIMIT_AUTH=30
ASSISTANT_DAILY_LIMIT_GUEST=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=oman-sale
# private = serve files via API (works with blocked public S3). public = direct S3 URLs.
MEDIA_S3_ACCESS=private
# Only for MEDIA_S3_ACCESS=public — must match the bucket region
# MEDIA_PUBLIC_BASE_URL=https://YOUR_BUCKET.s3.us-east-1.amazonaws.com

# Firebase (Google sign-in token verification on API)
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste the full service-account JSON on one line from Firebase Console > Project settings > Service accounts
# Never commit real keys — keep the value only in local .env
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Frontend Firebase (apps/web/.env.local) ---
# NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
# NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
