generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum TrustBadgeStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TrustIdentityDocumentType {
  NATIONAL_ID
  PASSPORT
}

enum CategoryType {
  PRODUCT
  SERVICE
  JOB
  JOB_REQUEST
  LOGISTICS
  CONSTRUCTION
}

enum AdType {
  PRODUCT
  SERVICE
  JOB
  JOB_REQUEST
  LOGISTICS
  CONSTRUCTION
}

enum AdStatus {
  DRAFT
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
  ARCHIVED
}

enum AdCondition {
  NEW
  USED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  THAWANI
  PAYPAL
}

enum CheckoutIntentKind {
  LISTING_PROMOTION
  STORE_CREATE
  BANNER_REQUEST
}

enum CheckoutIntentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationType {
  MESSAGE
  AD_APPROVED
  AD_REJECTED
  PAYMENT_SUCCESS
  PROMOTION_ACTIVE
  PROMOTION_EXPIRING
  ACCOUNT_BLOCKED
  ACCOUNT_DISABLED
  STORE_TRIAL_EXPIRED
  STORE_SUBSCRIPTION_EXPIRED
  STORE_SUBSCRIPTION_EXPIRING
  TRUST_BADGE_APPROVED
  TRUST_BADGE_REJECTED
  ADMIN_BANNER_REQUEST
  ADMIN_TRUST_BADGE_REQUEST
  ADMIN_REPORT
  SYSTEM
}

enum PushPlatform {
  WEB
  ANDROID
  IOS
}

enum ViewSource {
  WEB
  MOBILE
}

enum HeroSlidePlatform {
  WEB
  MOBILE
  ALL
}

enum BannerRequestStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  REJECTED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AuthCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
}

enum StoreBillingPeriod {
  ONE_MONTH
  TWO_MONTHS
  THREE_MONTHS
}

enum StoreDiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum StoreSubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum StoreBusinessType {
  COMMERCIAL
  HOME
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ArticleReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
  DISLIKE
}

model User {
  id               String    @id @default(uuid())
  fullName         String
  email            String    @unique
  phone            String?   @unique
  password         String
  avatar           String?
  googleId         String?   @unique
  profileCompleted Boolean   @default(true)
  role             UserRole  @default(USER)
  bio              String?
  isVerified       Boolean   @default(false)
  isActive         Boolean   @default(true)
  isBlocked        Boolean   @default(false)
  trustBadgeStatus TrustBadgeStatus @default(NONE)
  trustIdentityDocType TrustIdentityDocumentType?
  trustIdentityDocUrl String?
  trustBadgeReviewedAt DateTime?
  trustBadgeRejectionReason String?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  ads              Ad[]
  payments         Payment[]
  favorites        Favorite[]
  reports          Report[]
  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageReceiver")
  chatParticipants ConversationParticipant[]
  notifications    Notification[]
  pushTokens       PushToken[]
  refreshTokens    RefreshToken[]
  authCodes        AuthVerificationCode[]
  stores           Store[]
  bannerRequests   BannerRequest[]
  checkoutIntents  CheckoutIntent[]
  articleComments  ArticleComment[]
  articleReactions ArticleReaction[]
  articleSaves     ArticleSave[]

  @@index([role])
  @@index([isActive, isBlocked])
  @@index([trustBadgeStatus])
  @@index([createdAt])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model AuthVerificationCode {
  id         String          @id @default(uuid())
  email      String
  phone      String?
  codeHash   String
  purpose    AuthCodePurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime        @default(now())

  userId     String?
  user       User?           @relation(fields: [userId], references: [id])

  @@index([email, purpose])
  @@index([phone, purpose])
  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        String       @id @default(uuid())
  name      String
  nameAr    String       @default("")
  nameEn    String       @default("")
  slug      String       @unique
  icon      String?
  type      CategoryType
  parentId  String?
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  storeBaseMonthlyPrice Decimal? @db.Decimal(12, 3)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryTree")
  ads       Ad[]
  filters   CategoryFilter[]
  storePlanPricing StorePlanPricing[]
  stores    Store[]

  @@index([type])
  @@index([type, isActive])
  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
}

model CategoryFilter {
  id        String                 @id @default(uuid())
  titleAr   String
  titleEn   String
  slug      String
  sortOrder Int                    @default(0)
  isActive  Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  deletedAt DateTime?

  categoryId String
  category   Category               @relation(fields: [categoryId], references: [id])
  options    CategoryFilterOption[]
  values     AdFilterValue[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
}

model CategoryFilterOption {
  id        String          @id @default(uuid())
  labelAr   String
  labelEn   String
  slug      String
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  filterId  String
  filter    CategoryFilter  @relation(fields: [filterId], references: [id])
  values    AdFilterValue[]

  @@unique([filterId, slug])
  @@index([filterId])
  @@index([isActive])
  @@index([deletedAt])
}

model Ad {
  id           String       @id @default(uuid())
  title        String
  slug         String       @unique
  description  String
  type         AdType
  condition    AdCondition?
  price        Decimal?     @db.Decimal(12, 3)
  currency     String       @default("OMR")
  city         String?
  wilayah      String?
  area         String?
  latitude     Float?
  longitude    Float?
  contactPhone String?
  status       AdStatus     @default(ACTIVE)
  isApproved   Boolean      @default(true)
  isActive     Boolean      @default(true)
  isSold       Boolean      @default(false)
  soldAt       DateTime?
  views        Int          @default(0)
  expiresAt    DateTime?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectionReason String?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  userId       String
  user         User         @relation(fields: [userId], references: [id])
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id])
  storeId      String?
  store        Store?       @relation(fields: [storeId], references: [id])
  images       AdImage[]
  payment      Payment?
  promotion    AdPromotion?
  reports      Report[]
  favorites    Favorite[]
  conversations Conversation[]
  filterValues  AdFilterValue[]
  adViews       AdView[]

  @@index([status])
  @@index([isActive])
  @@index([isSold])
  @@index([createdAt])
  @@index([categoryId])
  @@index([userId])
  @@index([storeId])
  @@index([type])
  @@index([city, area])
  @@index([wilayah])
  @@index([expiresAt])
  @@index([deletedAt])
}

model AdView {
  id         String     @id @default(uuid())
  adId       String
  ad         Ad         @relation(fields: [adId], references: [id], onDelete: Cascade)
  visitorKey String
  ipAddress  String?
  source     ViewSource @default(WEB)
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@unique([adId, visitorKey])
  @@index([adId])
  @@index([ipAddress])
  @@index([createdAt])
}

model AdFilterValue {
  id        String               @id @default(uuid())
  createdAt DateTime             @default(now())
  deletedAt DateTime?

  adId      String
  ad        Ad                   @relation(fields: [adId], references: [id])
  filterId  String
  filter    CategoryFilter       @relation(fields: [filterId], references: [id])
  optionId  String
  option    CategoryFilterOption @relation(fields: [optionId], references: [id])

  @@unique([adId, filterId])
  @@index([adId])
  @@index([filterId])
  @@index([optionId])
  @@index([deletedAt])
}

enum AdMediaType {
  IMAGE
  VIDEO
}

model AdImage {
  id        String      @id @default(uuid())
  imageUrl  String
  mediaType AdMediaType @default(IMAGE)
  sortOrder Int         @default(0)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  adId      String
  ad        Ad       @relation(fields: [adId], references: [id])

  @@index([adId])
  @@index([deletedAt])
}

model CheckoutIntent {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id])
  kind      CheckoutIntentKind
  payload   Json
  amount    Decimal              @db.Decimal(12, 3)
  status    CheckoutIntentStatus @default(PENDING)
  result    Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  payment   Payment?

  @@index([userId, status])
  @@index([status, createdAt])
}

model Payment {
  id            String          @id @default(uuid())
  amount        Decimal         @db.Decimal(12, 3)
  currency      String          @default("OMR")
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider
  transactionId String?
  paymentUrl    String?
  paidAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  userId        String
  user          User            @relation(fields: [userId], references: [id])
  adId          String?         @unique
  ad            Ad?             @relation(fields: [adId], references: [id])
  promotionId   String?
  promotion     AdPromotion?    @relation(fields: [promotionId], references: [id])
  storeSubscriptionId String?   @unique
  storeSubscription   StoreSubscription? @relation(fields: [storeSubscriptionId], references: [id])
  bannerRequestId     String?   @unique
  bannerRequest       BannerRequest? @relation(fields: [bannerRequestId], references: [id])
  checkoutIntentId    String?   @unique
  checkoutIntent      CheckoutIntent? @relation(fields: [checkoutIntentId], references: [id])

  @@index([status])
  @@index([provider])
  @@index([userId])
  @@index([promotionId])
  @@index([checkoutIntentId])
  @@index([createdAt])
  @@index([deletedAt])
}

model PromotionPlan {
  id               String        @id @default(uuid())
  name             String        @unique
  description      String?
  nameAr           String        @default("")
  nameEn           String        @default("")
  descriptionAr    String        @default("")
  descriptionEn    String        @default("")
  pricePerDay      Decimal       @db.Decimal(12, 3)
  weekPrice        Decimal       @default(0) @db.Decimal(12, 3)
  twoWeeksPrice    Decimal       @default(0) @db.Decimal(12, 3)
  monthPrice       Decimal       @default(0) @db.Decimal(12, 3)
  priorityScore    Int
  dailyImpressions Int
  appearsFirst     Boolean       @default(false)
  badgeLabel       String?
  color            String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  promotions       AdPromotion[]
  storePlans         StoreSubscriptionPlan[]

  @@index([isActive])
  @@index([priorityScore])
  @@index([deletedAt])
}

model AdPromotion {
  id              String        @id @default(uuid())
  startsAt        DateTime
  endsAt          DateTime
  totalPrice      Decimal       @db.Decimal(12, 3)
  impressionsUsed Int           @default(0)
  isActive        Boolean       @default(true)
  expiryWarningNotifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  adId            String        @unique
  ad              Ad            @relation(fields: [adId], references: [id])
  planId          String
  plan            PromotionPlan @relation(fields: [planId], references: [id])
  payments        Payment[]
  dailyStats      AdPromotionDailyImpression[]

  @@index([planId])
  @@index([isActive])
  @@index([startsAt, endsAt])
  @@index([deletedAt])
}

model AdPromotionDailyImpression {
  id          String      @id @default(uuid())
  date        DateTime
  impressions Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  promotionId String
  promotion   AdPromotion @relation(fields: [promotionId], references: [id])

  @@unique([promotionId, date])
  @@index([date])
}

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  deletedAt DateTime?

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id])

  @@unique([userId, adId])
  @@index([adId])
  @@index([deletedAt])
}

model Report {
  id        String   @id @default(uuid())
  reason    String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  adId      String
  ad        Ad       @relation(fields: [adId], references: [id])

  @@index([userId])
  @@index([adId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Conversation {
  id            String   @id @default(uuid())
  directKey     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime?
  isBlocked     Boolean  @default(false)
  deletedAt     DateTime?

  adId          String
  ad            Ad       @relation(fields: [adId], references: [id])
  messages      Message[]
  participants  ConversationParticipant[]

  @@index([adId])
  @@index([lastMessageAt])
  @@index([deletedAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean      @default(false)
  deletedAt      DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([deletedAt])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  type           MessageType  @default(TEXT)
  imageUrl       String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  isRead         Boolean      @default(false)
  deletedAt      DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  receiverId     String
  receiver       User         @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  body      String
  type      NotificationType
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  deletedAt DateTime?

  userId    String
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([deletedAt])
}

model PushToken {
  id        String       @id @default(uuid())
  token     String
  platform  PushPlatform
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model HeaderNavButton {
  id        String   @id @default(uuid())
  sortOrder Int      @default(0)
  labelAr   String
  labelEn   String
  linkUrl   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model HeroSlide {
  id            String            @id @default(uuid())
  sortOrder     Int               @default(0)
  platform      HeroSlidePlatform @default(WEB)
  imageUrl      String
  titleAr       String
  titleEn       String
  subtitleAr    String
  subtitleEn    String
  buttonLabelAr String
  buttonLabelEn String
  buttonLink    String
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isActive, platform, sortOrder])
}

model HeroBanner {
  id              String         @id @default(uuid())
  sortOrder       Int            @default(0)
  imageUrl        String
  textAr          String?
  textEn          String?
  linkUrl         String
  isActive        Boolean        @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  bannerRequestId String?        @unique
  bannerRequest   BannerRequest? @relation(fields: [bannerRequestId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isActive, sortOrder])
  @@index([startsAt, endsAt])
}

model BannerPricing {
  id          String   @id @default(uuid())
  pricePerDay Decimal  @db.Decimal(12, 3)
  minDays     Int      @default(1)
  maxDays     Int      @default(90)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BannerRequest {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id])
  imageUrl        String
  linkUrl         String
  textAr          String?
  textEn          String?
  durationDays    Int
  totalPrice      Decimal             @db.Decimal(12, 3)
  status          BannerRequestStatus @default(PENDING_PAYMENT)
  rejectionReason String?
  startsAt        DateTime?
  endsAt          DateTime?
  approvedAt      DateTime?
  heroBanner      HeroBanner?
  payment         Payment?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TourismDestination {
  id                String   @id @default(uuid())
  slug              String   @unique
  sortOrder         Int      @default(0)
  imageUrl          String
  galleryImages     Json     @default("[]")
  titleAr           String
  titleEn           String
  rating            String   @default("4.9")
  ratingLabelAr     String
  ratingLabelEn     String
  aboutAr           String
  aboutEn           String
  highlightsAr      Json
  highlightsEn      Json
  activitiesAr      Json
  activitiesEn      Json
  bestTimeAr        String
  bestTimeEn        String
  addressAr         String
  addressEn         String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model StoreSubscriptionPlan {
  id            String   @id @default(uuid())
  nameAr        String
  nameEn        String
  descriptionAr String   @default("")
  descriptionEn String   @default("")
  sortOrder     Int      @default(0)
  trialDays          Int               @default(0)
  trialMaxListings   Int               @default(0)
  discountType       StoreDiscountType @default(NONE)
  discountValue      Decimal           @default(0) @db.Decimal(12, 3)
  isDiscountActive   Boolean           @default(false)
  isAdminFree        Boolean           @default(false)
  isActive           Boolean           @default(true)
  promotionPlanId    String?
  promotionPlan      PromotionPlan?    @relation(fields: [promotionPlanId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  pricing       StorePlanPricing[]
  subscriptions StoreSubscription[]

  @@index([isActive])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([promotionPlanId])
}

model StorePlanPricing {
  id               String             @id @default(uuid())
  billingPeriod    StoreBillingPeriod
  price            Decimal            @db.Decimal(12, 3)
  maxListings      Int
  discountType     StoreDiscountType  @default(NONE)
  discountValue    Decimal            @default(0) @db.Decimal(12, 3)
  isDiscountActive Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  planId     String
  plan       StoreSubscriptionPlan @relation(fields: [planId], references: [id])
  categoryId String
  category   Category              @relation(fields: [categoryId], references: [id])
  subscriptions StoreSubscription[]

  @@unique([planId, categoryId, billingPeriod])
  @@index([categoryId])
  @@index([planId])
  @@index([deletedAt])
}

model StoreType {
  id        String    @id @default(uuid())
  slug      String    @unique
  nameAr    String
  nameEn    String
  icon      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stores Store[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model Store {
  id             String   @id @default(uuid())
  slug           String   @unique
  nameAr         String
  nameEn         String
  bioAr          String   @default("")
  bioEn          String   @default("")
  logoUrl        String?
  coverUrl       String?
  phone          String?
  city           String?
  wilayah        String?
  businessType   StoreBusinessType @default(COMMERCIAL)
  nationalId     String
  commercialRegistrationNumber String?
  workingHours   Json?
  isActive       Boolean  @default(false)
  trustBadgeStatus TrustBadgeStatus @default(NONE)
  trustCommercialRegDocUrl String?
  trustOcciDocUrl String?
  trustSmeDocUrl String?
  trustOtherDocUrl String?
  trustOtherDocLabel String?
  trustBadgeReviewedAt DateTime?
  trustBadgeRejectionReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  userId         String
  user           User     @relation(fields: [userId], references: [id])
  rootCategoryId String
  rootCategory   Category @relation(fields: [rootCategoryId], references: [id])
  storeTypeId    String?
  storeType      StoreType? @relation(fields: [storeTypeId], references: [id])
  subscriptions  StoreSubscription[]
  ads            Ad[]

  @@index([userId])
  @@index([rootCategoryId])
  @@index([storeTypeId])
  @@index([city])
  @@index([wilayah])
  @@index([isActive])
  @@index([trustBadgeStatus])
  @@index([deletedAt])
}

model StoreSubscription {
  id             String                  @id @default(uuid())
  billingPeriod  StoreBillingPeriod
  basePrice      Decimal                 @db.Decimal(12, 3)
  discountAmount Decimal                 @default(0) @db.Decimal(12, 3)
  finalPrice     Decimal                 @db.Decimal(12, 3)
  maxListings       Int
  baselineListings  Int                     @default(0)
  isTrial           Boolean                 @default(false)
  status         StoreSubscriptionStatus @default(PENDING)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean                 @default(false)
  expiredNotifiedAt DateTime?
  expiryWarningNotifiedAt DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?

  storeId   String
  store     Store                 @relation(fields: [storeId], references: [id])
  planId    String
  plan      StoreSubscriptionPlan @relation(fields: [planId], references: [id])
  pricingId String
  pricing   StorePlanPricing      @relation(fields: [pricingId], references: [id])
  payment   Payment?

  @@index([storeId])
  @@index([planId])
  @@index([pricingId])
  @@index([status])
  @@index([isActive])
  @@index([endsAt])
  @@index([deletedAt])
}

model ArticleCategory {
  id        String   @id @default(uuid())
  slug      String   @unique
  nameAr    String
  nameEn    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@index([isActive, sortOrder])
}

model Article {
  id            String        @id @default(uuid())
  slug          String        @unique
  titleAr       String
  titleEn       String
  bodyAr        String        @db.Text
  bodyEn        String        @db.Text
  coverImageUrl String
  galleryImages Json          @default("[]")
  status        ArticleStatus @default(DRAFT)
  publishedAt   DateTime?
  views         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  categoryId String
  category   ArticleCategory @relation(fields: [categoryId], references: [id])

  articleViews     ArticleView[]
  saves            ArticleSave[]
  comments         ArticleComment[]
  reactions        ArticleReaction[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
}

model ArticleView {
  id         String     @id @default(uuid())
  articleId  String
  article    Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  visitorKey String
  ipAddress  String?
  source     ViewSource @default(WEB)
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@unique([articleId, visitorKey])
  @@index([articleId])
  @@index([createdAt])
}

model ArticleSave {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  deletedAt DateTime?

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  articleId String
  article   Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
  @@index([articleId])
  @@index([deletedAt])
}

model ArticleComment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@index([articleId])
  @@index([userId])
  @@index([createdAt])
  @@index([deletedAt])
}

model ArticleReaction {
  id        String              @id @default(uuid())
  type      ArticleReactionType
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
}

enum LegalDocumentKind {
  TERMS
  PRIVACY
  REFUND
}

model LegalDocument {
  id             String            @id @default(uuid())
  kind           LegalDocumentKind @unique
  titleAr        String
  titleEn        String
  bodyAr         String            @db.Text
  bodyEn         String            @db.Text
  contactTitleAr String            @default("")
  contactTitleEn String            @default("")
  contactTextAr  String            @default("")
  contactTextEn  String            @default("")
  isPublished    Boolean           @default(false)
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}
