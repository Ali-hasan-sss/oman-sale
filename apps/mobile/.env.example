# Skip Expo online dependency check (avoids startup crash when Expo API/cache fails)
EXPO_NO_DEPENDENCY_VALIDATION=1

# Monorepo: keep Metro project root at apps/mobile (not repo root) during release bundling
EXPO_NO_METRO_WORKSPACE_ROOT=1

# Local development
# EXPO_PUBLIC_API_URL=http://192.168.1.8:4000/api/v1
# EXPO_PUBLIC_API_DEBUG=true

# Production (EAS builds use eas.json env; this is the default for local release testing)
EXPO_PUBLIC_API_URL=https://omansale.om/api/v1
EXPO_PUBLIC_API_DEBUG=false

# Firebase Auth (Google Sign-In) — same Firebase project as web/API
# EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
# EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Web OAuth client ID from Firebase Console > Authentication > Sign-in method > Google
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# --- Android production build ---
# EAS project id (overrides app.json extra.eas.projectId)
# EAS_PROJECT_ID=e2a334ce-c188-4368-b610-78cb4b24ccc1
# Android versionCode for the next release (increment every store upload)
# ANDROID_VERSION_CODE=3
# Absolute/relative path to the Firebase Android config (defaults to ./google-services.json)
# Download from Firebase Console > Project settings > Your apps > Android (com.omansale.mobile)
# GOOGLE_SERVICES_JSON=./google-services.json
