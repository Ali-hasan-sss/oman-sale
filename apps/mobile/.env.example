# Skip Expo online dependency check (avoids startup crash when Expo API/cache fails)
EXPO_NO_DEPENDENCY_VALIDATION=1

# Local development
# EXPO_PUBLIC_API_URL=http://192.168.1.8:4000/api/v1
# EXPO_PUBLIC_API_DEBUG=true

# Production (EAS builds use eas.json env; this is the default for local release testing)
EXPO_PUBLIC_API_URL=https://omansale.om/api/v1
EXPO_PUBLIC_API_DEBUG=false
